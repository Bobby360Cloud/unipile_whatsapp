<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>360 SMS App</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">

    <style>
        body {
            font: 14px "Lucida Grande", Helvetica, Arial, sans-serif;
        }

        .spinner {
            border: 16px solid #f3f3f3;
            border-top: 16px solid #3498db;
            border-radius: 50%;
            width: 120px;
            height: 120px;
            animation: spin 2s linear infinite;
            margin: auto 50px;
            margin-top: 20px;
            display: none;
        }

        #wa-qrcode {
            display: block;
        }

        

        ol li {
            font-size: 16px;
            line-height: 22px;
            margin-top: 16px;
            color: #3b4a54;
        }

        @keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        .title {
            font-size: 25px;
            font-weight: 300;
            line-height: normal;
            color: #41525d;
        }

        .fs_2 {
            font-size: 22px;
        }

        .message_box {
            height: 200px;
            width: 200px;
            background: #3498db;
            position: relative;
            border-radius: 50%;
            margin-top: 30px;
        }

        .message_box2 {
            position: relative;
            top: 100px;
            text-align: center;
            font-size: 24px;
            margin: 0 !important;
        }

        .main_cn {
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            text-decoration: none;
            color: #fff;
        }

        .main_cn:hover {
            text-decoration: none;
        }
        #connecting-overlay {
    position: fixed;
    inset: 0;
    background: rgba(255, 255, 255, 0.95);
    display: none;               /* hidden by default */
    align-items: center;
    justify-content: center;
    z-index: 99999;
}

.connecting-box {
    text-align: center;
}

.connecting-box p {
    margin-top: 14px;
    font-size: 16px;
    color: #41525d;
}

.spinner1 {
    width: 56px;
    height: 56px;
    border: 6px solid #f3f3f3;
    border-top: 6px solid #25d366; /* WhatsApp green */
    border-radius: 50%;
    animation: spin 1s linear infinite;
}
#refresh-container{
    display: none;
}

@keyframes spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
}

    </style>
</head>

<body>
    <div id="qr-container" class="container-fluid">
        <div class="row">
            <div class="col-md-7">
                <div class="p-2 pt-4">
                    <p class="title">Use WhatsApp on your computer</p>
                    <ol>
                        <li>Open WhatsApp on your phone.</li>
                        <li>
                            Tap <strong>Menu</strong> or <strong>Settings</strong> and select
                            <strong>Linked Devices</strong>
                        </li>
                        <li>Tap on <strong>Link a device</strong></li>
                        <li>Point your phone to this screen to capture the QR code</li>
                    </ol>
                </div>
            </div>

            <!-- RIGHT QR AREA -->
            <div class="col-md-5 text-center">
                <!-- REFRESH -->
                <div id="refresh-container" class="fs_2 message_box" >
                    <a href="javascript:void(0)" class="main_cn" onclick="window.location.reload(true)">
                        <div class="p-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="70" height="70" viewBox="0 0 24 24"
                                style="fill:#fff;">
                                <path d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99
                                     3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55
                                     7.73-6h-2.08c-.82 2.33-3.04 4-5.65
                                     4-3.31 0-6-2.69-6-6s2.69-6 6-6
                                     c1.66 0 3.14.69 4.22 1.78L13 11h7V4z" />
                            </svg>
                            <p style="font-size:14px;color:#fff;margin-top:10px;">
                                Click to reload the QR Code!
                            </p>
                        </div>
                    </a>
                </div>
                <div id="spinner" class="spinner"></div>
                <img id="wa-qrcode" src="" alt="WhatsApp QR" class="img-fluid qr-image" style="display:none;" />
            </div>
        </div>
    </div>

    <p id="success-container" class="fs_2 text-center message_box2"></p>
    <div id="connecting-overlay">
    <div class="connecting-box">
        <div class="spinner1"></div>
        <p>Connecting…</p>
    </div>
   </div>


    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.3/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.min.js"></script>
    <script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>

    <script>
        
        $(document).ready(function () {
            function autoloadqr(){
            clearInterval(qrInterval);
                    qrInterval = setInterval(() => {
                        socket.emit("qr", { sessionId: sessionId.replace(/\s/g, "") });
                    }, 30000);
        }
            const HOST = "<%= HOST %>";

            const spinner = document.getElementById('spinner');
            spinner.style.display = "block";

            socket = io(HOST, { secure: false });
            const imgEle = document.getElementById('wa-qrcode');
            const qrContainer = document.getElementById('qr-container');
            const successContainer = document.getElementById('success-container');
            const refreshContainer = document.getElementById('refresh-container');
            const connectingOverlay = document.getElementById("connecting-overlay");
            connectingOverlay.style.display = "none";
            imgEle.style.display = "none";
            refreshContainer.style.display = "none";
            const urlParams = new URLSearchParams(window.location.search);
            const orgId = urlParams.get('orgid');
            const userId = urlParams.get('userid');
            const sessionId = `${orgId}${userId}`;
            let isQrAuthenticated = false;
            let qrInterval;
            socket.on("connect", function () {
                console.log("connected to server");
                socket.emit("room", sessionId.replace(/\s/g, ""));
                socket.emit("qr", { sessionId: sessionId.replace(/\s/g, "") });
            });
            socket.on("disconnect", function () {
                console.log("disconnected from server");
            });
            socket.on("error", (error) => {
                console.error("socket error:", error);
            });
            socket.on("status", (data) => {
                console.log("..............", data);
                if (data?.status === "authenticated") {
                    qrContainer.style.display = "none";
                    successContainer.innerHTML = "You are authenticated.";
                    refreshContainer.style.display = "none";
                    connectingOverlay.style.display = "none";
                    isQrAuthenticated = true;
                    clearInterval(qrInterval);
                    //spinner.style.display = "none";
                } else if (data?.status === "qr_generated") {
                    refreshContainer.style.display = "none";
                    imgEle.style.display = "block";
                    imgEle.src = data.src;
                    spinner.style.display = "none";
                    connectingOverlay.style.display = "none";
                    if(!isQrAuthenticated)
                      autoloadqr();
                } else if (data?.status === "qr_error") {
                    // imgEle.style.display = "none";
                    // setTimeout(() => {
                    //     refreshContainer.style.display = "block";
                    //     spinner.style.display = "none";
                    // }, 2000);
                    if(!isQrAuthenticated)
                       autoloadqr();
                    
                } else if (data?.status === "connecting") {
                    imgEle.style.display = "none";
                    refreshContainer.style.display = "none";
                    spinner.style.display = "none";
                    connectingOverlay.style.display = "flex";
                }
                else if (data?.status === "loading_qr") {
                    spinner.style.display = "block";
                    imgEle.style.display = "none";
                    refreshContainer.style.display = "none";
                    autoloadqr();
                }
            });
        });





    </script>
</body>

</html>